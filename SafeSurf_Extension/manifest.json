{
  "manifest_version": 3,
  "name": "Safe-Surf | Phishing Intelligence",
  "version": "1.0.0",
  "description": "Real-time threat intelligence and phishing detection powered by Safe-Surf AI.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
